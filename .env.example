# ---- Required ---------------------------------------------------------------
# Bearer token accepted by the API. Generate one with:
#   openssl rand -hex 32
SIMPLE_DRIVE_TOKEN=change-me

# Active storage backend: local | database | s3 | ftp
STORAGE_BACKEND=local

# ---- local backend ----------------------------------------------------------
LOCAL_STORAGE_PATH=./storage/blobs

# ---- s3 backend (AWS S3, minio, DO Spaces, Linode, ...) --------------------
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=simple-drive
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ---- ftp backend ------------------------------------------------------------
# FTP_HOST=ftp.example.com
# FTP_PORT=21
# FTP_USER=user
# FTP_PASSWORD=secret
# FTP_BASE_DIR=simple_drive
# FTP_PASSIVE=true
